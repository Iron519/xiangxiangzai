## 运行目录
WORK_PATH=/app

## LLM通用BASE_URL
BASE_URL=https://llm-example.aliyuncs.com/compatible-mode/v1

## ACCESSCODE（密钥，勿提交真实值）
ACCESSCODE=

## 文本LLM
TEXT_MODEL=qwen3.8-flash

## 多模态VLM
VLM_MODEL=qwen3.8-flash

## 快速模型LLM
FAST_MODEL=qwen3.7-flash

## 极速判断模型Jev（TypeSafe将自动读取该值，无需手动引用；也不需要手动选模型，SDK 默认使用 jev-latest）
TYPESAFE_API_KEY=

## EMBEDDING模型
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIM=1024

## RERANK模型
RERANK_MODEL=qwen3.7-text-rerank
RERANK_BASE_URL=https://dashscope.aliyuncs.com

## MinerU官方API
MINERU_TOKEN=
MINERU_API_BASE=https://mineru.net

# Office转PDF工具地址
SOFFICE_PATH=/usr/bin/soffice

## PG数据表
# PG连接参数（密钥，勿提交真实值）
PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=
TS_CONFIG=jiebacfg
# 业务数据表名
PG_MYAGENT_KB_TABLE=myagent_kb_chunks
PG_MYAGENT_CONVERSATIONS_TABLE=myagent_conversations_history
PG_MYAGENT_SESSIONS_TABLE=myagent_sessions
PG_MYAGENT_UPLOAD_TASKS_TABLE=myagent_upload_tasks
PG_MYAGENT_FAQ_TABLE=myagent_faq
PG_MYAGENT_SCENE_TABLE=myagent_scene_templates
# 用户表名
PG_MYAGENT_USER_TABLE=myagent_user

## 鉴权（账号密码 + Redis session，单表无 RBAC）
# Redis 连接
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Session 有效期（小时）
SESSION_TTL_HOURS=240
# 管理员 uid（此用户拥有用户管理权限）
ADMIN_UID=admin
# 管理员初始密码（仅首次建表时使用）
ADMIN_PASSWORD=

## FAQ 快速匹配阈值
# 阈值A：查询词对TOP1文档的IDF加权覆盖率
FAQ_COVERAGE_THRESHOLD=0.95
# 阈值B：TOP1/(TOP1+TOP2) 占比。
FAQ_RATIO_THRESHOLD=0.65

## 敏感话题检测
SENSITIVE_TOPICS=查询他人信息
SENSITIVE_REPLY=抱歉，这个话题比较敏感，我无法回答。

## 用户画像定时更新周期（小时）
USER_PROFILE_INTERVAL_HOURS=12

## 兜底话术（系统异常时返回给用户的提示文案）
# LLM 生成失败或返回空内容
FALLBACK_LLM_ERROR=抱歉，我暂时无法回答您的问题，请稍后再试。
# 主图节点崩溃或流式输出异常
FALLBACK_SYSTEM_ERROR=抱歉，系统暂时遇到问题，请稍后再试。
# 主图整体超时（超过60s无响应）
FALLBACK_TIMEOUT=抱歉，系统响应超时，请稍后再试。
# 主图完成但未产出任何内容（空响应）
FALLBACK_EMPTY_RESPONSE=抱歉，我暂时没有生成有效回答，请尝试换个问法或稍后再试。
# 用户主动中止回答时的话术
ABORT_REPLY=回答已中止。
# 工具调用失败时返回给LLM的提示（LLM会转述给用户）
FALLBACK_TOOL_ERROR=相关查询暂时不可用，请稍后再试。
# 知识库中没有检索到问题的相关内容
FALLBACK_NO_KB_HIT=抱歉，当前知识库中没有找到与您问题相关的内容，我不能凭空捏造。

# ================= 前端等待提示 =================
# 节点 → 提示文案映射（JSON 格式，key 为 LangGraph 节点名/tag，value 为面向用户的提示语）
# 节点名对应 generate_answer.py 中的 graph 节点：node_plan_retrieval / node_retrieve / node_generate / node_faq_match / tool_node
# 工具名对应 TOOL_QUERY_HINTS：query_leave_quota / query_leave_record / query_working_time / query_personal_info
NODE_HINTS={"node_plan_retrieval":"正在理解您的问题","node_retrieve":"正在检索知识库","node_faq_match":"正在匹配常见问题","node_generate":"正在生成回答","tool_node":"正在调用工具"}
# 工具名 → 面向用户的「正在查询…」提示文案（仅前端展示用，不发给 LLM）
TOOL_QUERY_HINTS={"query_leave_quota":"正在查询您的假期额度","query_leave_record":"正在查询您的请假记录","query_working_time":"正在查询您的工时数据","query_personal_info":"正在查询您的个人信息"}
# 等待小贴士列表（JSON 数组，用户等待超过 3 秒后前端轮播展示）
WAITING_TIPS=["首轮回答可能会比较慢，请您耐心等待","我的每轮回答都只说重点，晕字症友好","你可以通过下方的追问不断探索","追问将带领你一步一步轻松地了解全貌","同一对话单元的话题尽量一致，这样会更准确","关联工具或场景，我将自动按需调用"]
# 小贴士轮播间隔（秒）
WAITING_TIPS_INTERVAL=3
