## 运行目录
WORK_PATH=/root/iron/HRSSC_Management

## LLM通用BASE_URL
BASE_URL=https://beaconapi.bmwbrill.cn/project-golive/v1

## ACCESSCODE（密钥，勿提交真实值）
ACCESSCODE=

## 文本LLM
TEXT_MODEL=qwen3.7-plus

## 多模态VLM
VLM_MODEL=qwen3.7-plus

## 快速模型LLM
FAST_MODEL=deepseek-v4-flash

## EMBEDDING模型
EMBEDDING_MODEL=qwen3-embedding-8b
EMBEDDING_DIM=4096

## RERANK模型
RERANK_MODEL=qwen3-reranker-8b
RERANK_BASE_URL=https://dashscope.aliyuncs.com

## PG数据表
# PG连接参数（密钥，勿提交真实值）
PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=
TS_CONFIG=jiebacfg
# 业务数据表名
PG_HRSSC_KB_TABLE=hrssc_kb_chunks_mgmt
PG_HRSSC_CONVERSATIONS_TABLE=hrssc_conversations_history_mgmt
PG_HRSSC_UPLOAD_TASKS_TABLE=hrssc_upload_tasks_mgmt
PG_HRSSC_FAQ_TABLE=hrssc_faq_mgmt
PG_HRSSC_SCENE_TABLE=hrssc_scene_templates
# RBAC 表名
PG_HRSSC_USER_TABLE=hrssc_user_mgmt
PG_HRSSC_ROLE_TABLE=hrssc_role_mgmt
PG_HRSSC_USER_ROLE_TABLE=hrssc_user_role_mgmt
PG_HRSSC_PERMISSION_TABLE=hrssc_permission_mgmt
PG_HRSSC_ROLE_PERMISSION_TABLE=hrssc_role_permission_mgmt

## FAQ 快速匹配阈值
FAQ_COVERAGE_THRESHOLD=0.95
FAQ_RATIO_THRESHOLD=0.65

## 敏感话题检测
SENSITIVE_REPLY=抱歉，我无法回答这个问题。
SENSITIVE_TOPICS=薪酬、绩效、晋升、查询他人信息、投诉/法律/审计相关问题

## MinerU
MINERU_URL=https://cnapi-service-i.ali.bba.cloud.bmw/aiplatform/ocrmanagementmineru/v1/file_parse
MINERU_API_KEY=

# Office转PDF工具地址
SOFFICE_PATH=/opt/libreoffice25.8/program/soffice

## 通用鉴权（手机号验证码 + 微信）
SMS_DRIVER=mock
VERIFY_CODE_TTL_MINUTES=5
VERIFY_CODE_MAX_ATTEMPTS=5
VERIFY_CODE_SEND_COOLDOWN_SECONDS=60
AUTH_DEFAULT_ROLE=guest
# 微信小程序
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=
# 微信公众号 H5
WECHAT_MP_APPID=
WECHAT_MP_SECRET=
# JWT（密钥，勿提交真实值）
JWT_ACCESS_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720
# RBAC 身份绑定表
PG_HRSSC_IDENTITY_TABLE=hrssc_identity_mgmt
PG_HRSSC_VERIFY_CODE_TABLE=hrssc_verify_code_mgmt
PG_HRSSC_PASSWORD_TABLE=hrssc_password_mgmt

## TypeSafe AI (System One 模型)
TYPESAFE_API_KEY=

## Chat Tag
CHAT_TAG_INTERVAL_HOURS=6
CHAT_TAG_BATCH_SIZE=20
CHAT_TAG_CONCURRENCY=5